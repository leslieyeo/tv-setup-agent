+        Intent panel = new Intent("com.tcl.settings.SHOW_WINDOW")
+                .setComponent(new ComponentName("com.tcl.settings", "com.tcl.settings.ShowWindowService"))
+                .putExtra("Type", type);
+        if (!item.isEmpty()) panel.putExtra("ITEM", item);
+        try {
+            return startService(panel) != null;
+        } catch (RuntimeException e) {
+            android.util.Log.w("TvHome", "TCL native panel unavailable", e);
+            return false;
+        }
     }
 
 
